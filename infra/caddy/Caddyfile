# Caddy is the public entrypoint in production. It terminates TLS (automatic
# Let's Encrypt certificate for $DOMAIN, auto-renewed) and reverse-proxies
# everything to the internal nginx container.
#
# DOMAIN and ACME_EMAIL come from infra/.env via docker-compose.prod.yml.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80
}
