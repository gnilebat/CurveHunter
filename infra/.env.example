# Copy this to infra/.env and fill in real values. infra/.env is gitignored —
# never commit it.

# ── Postgres / PostGIS ───────────────────────────────────────────────────────
# Used by the backend and the curvature ETL. Pick a long random password.
POSTGRES_USER=curvehunter
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=curvehunter

# ── Production only (docker-compose.prod.yml) ────────────────────────────────
# Your domain and an email for Let's Encrypt. Caddy uses these to obtain and
# auto-renew the TLS certificate. Leave blank / ignore for local dev.
DOMAIN=schraeglage-maps.de
ACME_EMAIL=tabeling.johannes@gmail.com
