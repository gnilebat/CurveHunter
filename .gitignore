# Dependencies
frontend/node_modules/
frontend/dist/

# Python
__pycache__/
*.pyc
.venv/
etl/.venv/
backend/.venv/

# Environment
infra/.env
.env

# Large data files — download separately, never commit
infra/tiles/*.pmtiles
infra/data/osm/*.pbf
infra/data/osm/*.osm
infra/data/dem/*.tif
infra/data/dem/*.tiff

# Geocoder build inputs/outputs (see infra/GEOCODER.md) — keep the dirs,
# ignore their (large) contents.
infra/import/pbf/*
!infra/import/pbf/.gitkeep
infra/photon-index/*
!infra/photon-index/.gitkeep

# Docker volumes (if bind-mounted locally)
infra/data/postgres/
infra/data/nominatim/
infra/data/graphhopper/

# OS
.DS_Store
Thumbs.db

# Playwright / E2E
frontend/.screenshots/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
